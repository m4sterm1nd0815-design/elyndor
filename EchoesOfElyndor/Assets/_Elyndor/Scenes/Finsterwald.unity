MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 390918293}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: d0e73193d895ea2489d77b9663eece5e, type: 3}
  m_Name:
  m_EditorClassIdentifier: Elyndor.Runtime::Elyndor.Interaction.QuestGiver
  interactionPrompt: Mit Teren sprechen
  questId: teren_packtier
  objectiveId: teren_packtier_ziel
  introText: "Teren: \u201EMein Packtier ist durchgegangen! Einfach so, mitten auf
    dem Weg \u2014 als haette es etwas gesehen, das nicht da war. Es kann nicht weit
    sein.\u201C"
  reminderText: "Teren: \u201EFlussaufwaerts, Richtung Furt. Sei behutsam \u2014
    es zittert vor etwas, das keiner von uns sehen kann.\u201C"
  completionText: "Das Tier folgt dir ruhig zurueck. Teren streicht ihm ueber die
    Nuestern. \u201EWas auch immer du gesehen hast, Alter \u2014 es ist fort.\u201C
    Er sieht Aren nachdenklich an. \u201EOder es war nie fort. Nur vergessen.\u201C"
  idleText: Teren prueft seine Ladung und wirft dem Packtier besorgte Blicke zu.
  textDuration: 7
