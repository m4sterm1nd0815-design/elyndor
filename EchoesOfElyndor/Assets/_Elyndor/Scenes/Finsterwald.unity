  m_Name:
  m_EditorClassIdentifier: Elyndor.Runtime::Elyndor.Interaction.QuestObjective
  interactionPrompt: Packtier beruhigen
  questId: teren_packtier
  objectiveId: teren_packtier_ziel
  foundText: "Das Tier steht zitternd vor einer leeren Wegstelle und starrt sie an.
    Die Memory Watch tickt kurz \u2014 hier verlief einmal ein Zaun. Aren spricht
    leise, legt die Hand auf den warmen Hals. Das Zittern hoert auf."
  textDuration: 7
  visualRoot: {fileID: 199660130}
