  m_Name: 
  m_EditorClassIdentifier: Elyndor.Runtime::Elyndor.Memory.MemorySite
  interactionPrompt: Memory Watch verwenden
  siteId: nebelmoor_steg_01
  echoes:
  - {fileID: 482451804}
  activationDuration: 2.5
  memoryText: "Die Memory Watch wird schwer wie nasses Holz. Ueber dem schwarzen
    Wasser erscheinen Planken aus Licht \u2014 der alte Steg der Moorleute. Man hoerte
    ihre Laternen frueher bis zum Wald, sagt man. Dann kam das Vergessen, und niemand
    fand den Weg mehr hinaus."
  memoryTextDuration: 8
