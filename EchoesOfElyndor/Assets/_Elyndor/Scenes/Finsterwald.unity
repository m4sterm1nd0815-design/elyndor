--- !u!114 &179777404
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 179777402}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: d0e73193d895ea2489d77b9663eece5e, type: 3}
  m_Name:
  m_EditorClassIdentifier: Elyndor.Runtime::Elyndor.Interaction.QuestGiver
  interactionPrompt: Mit Ilya sprechen
  questId: ilya_marken
  objectiveId: ilya_marken_ziel
  introText: "Ilya: \u201EIch richte die Wegmarken des Waldes. Eine ist umgestuerzt
    \u2014 westlich von hier. Stell sie wieder auf, wenn du magst. Wanderer verlaufen
    sich sonst.\u201C"
  reminderText: "Ilya: \u201EDie Marke liegt westlich, am Lichtungsweg. Vorsicht:
    Mir war, als zeigte sie kurz einen Weg, den es gar nicht gibt.\u201C"
  completionText: "Ilya nickt langsam. \u201EDu hast es auch gesehen, oder? Den Weg,
    den es nicht gibt.\u201C Sie blickt nach Norden. \u201EVielleicht gab es ihn.
    Vielleicht erinnert sich der Wald besser als wir.\u201C"
  idleText: Ilya prueft ihre Karten und vergleicht sie stirnrunzelnd mit den Wegen.
  textDuration: 7
