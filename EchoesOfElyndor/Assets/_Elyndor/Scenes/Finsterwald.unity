--- !u!114 &452253539
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 452253537}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: d0e73193d895ea2489d77b9663eece5e, type: 3}
  m_Name:
  m_EditorClassIdentifier: Elyndor.Runtime::Elyndor.Interaction.QuestGiver
  interactionPrompt: Mit Borin sprechen
  questId: borin_axt
  objectiveId: borin_axt_ziel
  introText: "Borin: \u201EMeine Axt liegt da drueben im Dickicht. Hol sie mir, ja?
    Ich... gehe da nicht mehr rein. Frag nicht, warum. Ich weiss es selbst nicht.\u201C"
  reminderText: "Borin: \u201EOstwaerts, beim grossen Fels. Ich kann dir nicht sagen,
    wovor ich Angst habe. Das ist ja das Schlimmste.\u201C"
  completionText: "Borin nimmt die Axt, wiegt sie in der Hand. \u201ENichts. Da war
    nichts Boeses, oder? Nur Baeume.\u201C Er lacht unsicher. \u201EWarum hatte ich
    dann solche Angst?\u201C"
  idleText: Borin hackt Holz, bleibt aber stets mit dem Ruecken zum Osten.
  textDuration: 7
